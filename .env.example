# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: comma-separated fallback chain, tried in order when a model is overloaded
GEMINI_MODEL=gemini-3.6-flash,gemini-2.5-flash,gemini-3.5-flash
PORT=8080
# Set to 1 behind Cloud Run / Render so rate limits use the real client IP
TRUST_PROXY=0
AI_RATE_PER_MINUTE=12
