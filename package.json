{
  "name": "utsav-ai",
  "version": "1.0.0",
  "description": "GenAI celebration and event planner: budget split, back-scheduled timeline, vendor checklist and personalised ideas powered by Google Gemini.",
  "type": "module",
  "main": "server.js",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file-if-exists=.env server.js",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-exclude=test/**",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p jsconfig.json",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "22.9.0",
    "eslint": "9.39.5",
    "globals": "15.11.0",
    "prettier": "3.3.3",
    "typescript": "5.6.3"
  }
}
